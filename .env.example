# ===========================================
# Noga - WhatsApp AI Home Assistant
# Environment Configuration
# ===========================================

# Database (Postgres — see docker-compose.yml's `db` service)
POSTGRES_USER=noga
POSTGRES_PASSWORD=change-me
POSTGRES_DB=noga
# Built from the vars above inside docker-compose.yml; only override if connecting to an
# external/non-compose Postgres instance.
DB_URL=postgresql://noga:change-me@db:5432/noga
# Single tenant today (Block 2) — every row in Postgres is scoped to this value.
DEFAULT_TENANT_ID=family_core
# Block 3: 'legacy' (default) = hardcoded skills/prompt, unchanged behavior. 'markdown' =
# tenant-scoped identity.md + generic tool primitives. Canary-test before flipping in production.
BEHAVIOR_ENGINE=legacy

# Dashboard Settings
DASHBOARD_PORT=3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme
SESSION_SECRET=your-random-session-secret-here

# Block 5 Phase 1: internal API the admin-portal container calls on the orchestrator container
# for live in-memory state (WhatsApp/Gemini status, dashboard chat, reinit-on-file-edit).
# Not exposed publicly — same Docker network only, plus this shared secret.
INTERNAL_API_PORT=3100
ORCHESTRATOR_INTERNAL_URL=http://noga:3100
INTERNAL_API_SECRET=your-random-internal-secret-here

# WhatsApp Whitelist
# Comma-separated phone numbers (with country code, no + or spaces)
WHATSAPP_WHITELIST=972501234567,972509876543
# Optional: Specific group ID to respond in (get from message logs)
WHATSAPP_GROUP_ID=
# Optional: Admin phone number for /log, /backup, /restart commands (with country code, no + or spaces)
ADMIN_PHONE=972501234567

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CONTEXT_WINDOW_MESSAGES=10

# Google APIs - Service Account (for Calendar)
# Path to your service account JSON file
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# Google APIs - OAuth2 (for Tasks)
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token

# Calendar Settings
# Use 'primary' for the main calendar or the calendar ID
CALENDAR_ID=primary

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your-long-lived-access-token

# Logging
LOG_LEVEL=info
